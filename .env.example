# Baraza configuration. Copy this file to `.env` and edit what you need.
# Everything is optional: with no .env at all Baraza uses local Ollama (llama3),
# SQLite and free data sources. Most of these can also be changed in the app
# under Settings; values saved there override this file.

# --- Web server -------------------------------------------------------------
DEBUG=True
# Leave empty to generate one automatically (stored in data/secret_key.txt).
SECRET_KEY=
# Comma-separated host names when you serve Baraza to other people.
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://baraza.example.org
# Require users to log in (create accounts with `python manage.py createsuperuser`).
REQUIRE_LOGIN=False
TIME_ZONE=Africa/Nairobi
# Where the database, uploads and logs are kept.
# BARAZA_DATA_DIR=./data
# PostgreSQL instead of SQLite (optional):
# DATABASE_URL=postgres://user:password@localhost:5432/baraza

# --- Language model -----------------------------------------------------------
# ollama  = free, runs on your computer (default; `ollama pull llama3`)
# openai  = any OpenAI-compatible API: Groq, OpenRouter, Together, DeepSeek,
#           Gemini (OpenAI endpoint), LM Studio, vLLM, llama.cpp server, OpenAI
# fake    = offline demo model (no AI; for trying the interface)
# none    = no language model; transparent heuristics everywhere
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Optional smaller/faster model for agent posts, e.g. llama3.2:3b
OLLAMA_FAST_MODEL=
# Optional embeddings for better retrieval (`ollama pull nomic-embed-text`)
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192

# OpenAI-compatible provider. Groq and OpenRouter have free tiers.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_FAST_MODEL=
OPENAI_EMBED_MODEL=
# True = send only the brief, dossier and report to the provider above while
# agents keep using local Ollama (best quality for almost no cost).
HYBRID_SMART_TIER=False
# Used to show estimated spend for paid APIs (USD per million tokens).
LLM_COST_PER_1M_INPUT_USD=0
LLM_COST_PER_1M_OUTPUT_USD=0
# Parallel requests to the model. Keep 1-2 for a laptop running Ollama.
LLM_CONCURRENCY=2
LLM_TIMEOUT=240
LLM_CACHE=True

# --- Background jobs -----------------------------------------------------------
# thread = run inside the web server (zero setup)
# worker = run `python manage.py run_worker` in a second terminal (robust)
JOB_RUNNER=thread
MAX_CONCURRENT_JOBS=2
DEFAULT_COUNTRY=KE
LOG_LEVEL=INFO

# --- Research etiquette -----------------------------------------------------------
RESPECT_ROBOTS_TXT=True
ANONYMIZE_SOCIAL_AUTHORS=True
HTTP_TIMEOUT=20
# HTTP_USER_AGENT=BarazaResearchBot/1.0 (+https://your-site; contact@example.org)

# --- Free data sources (optional keys) ------------------------------------------
# YouTube Data API v3 key (free daily quota): comments under news videos
YOUTUBE_API_KEY=
# Reddit "script" app (free): more reliable than public JSON
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Self-hosted SearXNG metasearch, e.g. http://localhost:8888 (docker compose --profile searxng up -d)
SEARXNG_URL=
# Public Telegram channels to search, comma-separated, without @
TELEGRAM_CHANNELS=
# Extra RSS/Atom feeds, comma-separated
CUSTOM_RSS_FEEDS=
MASTODON_INSTANCE=https://mastodon.social
# Bluesky works without login; an app password raises rate limits
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Jina Reader for JavaScript-heavy pages (works without a key, a free key raises limits)
JINA_API_KEY=

# --- Low-cost data sources (free credits, then paid) --------------------------
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# Apify scrapers for X, TikTok, LinkedIn and Facebook public posts
APIFY_TOKEN=
# APIFY_ACTOR_X=apidojo~tweet-scraper
# APIFY_ACTOR_TIKTOK=clockworks~tiktok-scraper
# APIFY_ACTOR_LINKEDIN=harvestapi~linkedin-post-search
# APIFY_ACTOR_FACEBOOK=apify~facebook-posts-scraper   (set to "off" to disable an actor)
# APIFY_FACEBOOK_PAGES=https://www.facebook.com/SomePublicPage
# twitterapi.io (pay-as-you-go X search)
TWITTERAPI_IO_KEY=
# Official X API (paid)
X_BEARER_TOKEN=
